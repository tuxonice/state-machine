{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the state machine"
    },
    "states": {
      "type": "array",
      "description": "List of states in the state machine",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the state"
          },
          "isCurrent": {
            "type": "boolean",
            "description": "If this is the current state of the state machine"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "description": "List of transitions between states",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "State from which the transition starts"
          },
          "target": {
            "type": "string",
            "description": "State to which the transition leads"
          },
          "event": {
            "type": "string",
            "description": "Event that triggers the transition"
          },
          "condition": {
            "type": ["string", "null"],
            "description": "Optional condition for the transition"
          }
        },
        "required": ["source", "target"],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "description": "List of events related to state transitions",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the event"
          },
          "command": {
            "type": ["string", "null"],
            "description": "Optional command related to the event"
          },
          "onEnter": {
            "type": ["boolean"],
            "description": "State machine automatically executes it when the current state is the same as the source state of the transition"
          },
          "timeout": {
            "type": ["string"],
            "description": "Events can be triggered after a defined period of time has passed through a timeout"
          },
          "manual": {
            "type": ["boolean"],
            "description": "The transition should be trigger manually"
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "states", "transitions", "events"],
  "additionalProperties": false
}
