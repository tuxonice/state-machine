{
    "name": "tlab/state-machine",
    "description": "PHP Package to manage state machines",
    "type": "library",
    "keywords": [
        "state-machine",
        "workflow",
        "fsm",
        "psr-11",
        "psr-14"
    ],
    "license" : "MIT",
    "authors": [
        {
            "name": "Helder Correia",
            "email": "tuxboy@tlab.pt",
            "role" : "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Tlab\\StateMachine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tlab\\Tests\\": "tests/Unit"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "opis/json-schema": "^2.3",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0"
    },
    "suggest": {
        "jbzoo/mermaid-php": "Needed by the Designer to render Mermaid diagrams, see DiagramRenderer to use another library"
    },
    "minimum-stability" : "stable",
    "require-dev": {
        "jbzoo/mermaid-php": "^7.2",
        "symfony/var-dumper": "^7.1",
        "squizlabs/php_codesniffer": "^3.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.3"
    },
    "scripts": {
        "cs": "phpcs",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
